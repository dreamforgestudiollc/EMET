{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dreamforgestudiollc/emet",
  "title": "EMET",
  "description": "ISO 9001 7.5.3 / ISO 13485 4.2.5 document-control memory for AI agents. Nothing is deleted.",
  "version": "0.3.8",
  "websiteUrl": "https://dreamforgestudiollc.github.io/EMET/",
  "repository": {
    "url": "https://github.com/dreamforgestudiollc/EMET",
    "source": "github",
    "id": "1402031262"
  },
  "icons": [
    {
      "src": "https://dreamforgestudiollc.github.io/EMET/assets/icon-48.png",
      "mimeType": "image/png",
      "sizes": ["48x48"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dreamforgestudiollc/emet",
      "version": "0.3.8",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MONGODB_URI",
          "description": "MongoDB connection string for the memory store.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "EMET_TAG_HANDOFFS",
          "description": "Per-tag handoffs. Off unless set to warn or enforce.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "EMET_HUB_TAG",
          "description": "Hub tag that writes HANDOFF.md when per-tag handoffs are on.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "EMET_HANDOFF_AGING_DAYS",
          "description": "Days before a handoff line in the computed view is aging. Default 7.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "EMET_STALE_OPEN_HOURS",
          "description": "Hours before an open session with material work is marked stale-open. Default 24.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "accept_nonconformance",
        "corpus_recall",
        "emet_client_approve",
        "emet_error_report",
        "emet_floor",
        "emet_gaps",
        "emet_initialize",
        "emet_invite_create",
        "emet_member_access_create",
        "emet_page",
        "emet_page_lint",
        "emet_pages",
        "emet_session_close",
        "emet_session_open",
        "emet_setup_complete",
        "emet_status",
        "emet_subkey_claim",
        "emet_subkey_end_session",
        "emet_subkey_request",
        "emet_subkey_revoke",
        "emet_subkey_set_kind",
        "emet_transcript_append",
        "list_docs",
        "patch_doc",
        "query_layer",
        "query_transcripts",
        "read_doc",
        "read_doc_history",
        "recall",
        "rename_doc",
        "restore_doc",
        "retire_doc",
        "revise_memory",
        "revise_transcript",
        "save_to_layer",
        "save_transcript",
        "semantic_recall",
        "validate_doc",
        "write_doc",
        "write_doc_abort",
        "write_doc_append",
        "write_doc_begin",
        "write_doc_commit"
      ]
    }
  }
}
