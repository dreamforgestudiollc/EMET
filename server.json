{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dreamforgestudiollc/emet",
  "title": "EMET",
  "description": "0.3.2. Free MIT; no account, key, or payment. Verifies record, not computation. Stable error codes.",
  "version": "0.3.2",
  "websiteUrl": "https://dreamforgestudiollc.github.io/EMET/",
  "repository": {
    "url": "https://github.com/dreamforgestudiollc/EMET",
    "source": "github",
    "id": "1402031262"
  },
  "icons": [
    {
      "src": "https://dreamforgestudiollc.github.io/EMET/assets/icon-48.png",
      "mimeType": "image/png",
      "sizes": ["48x48"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dreamforgestudiollc/emet",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MONGODB_URI",
          "description": "MongoDB connection string for the memory store.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "accept_nonconformance",
        "corpus_recall",
        "emet_client_approve",
        "emet_error_report",
        "emet_floor",
        "emet_gaps",
        "emet_initialize",
        "emet_invite_create",
        "emet_member_access_create",
        "emet_page",
        "emet_page_lint",
        "emet_pages",
        "emet_session_close",
        "emet_session_open",
        "emet_setup_complete",
        "emet_status",
        "emet_subkey_claim",
        "emet_subkey_end_session",
        "emet_subkey_request",
        "emet_subkey_revoke",
        "emet_transcript_append",
        "list_docs",
        "patch_doc",
        "query_layer",
        "query_transcripts",
        "read_doc",
        "read_doc_history",
        "recall",
        "rename_doc",
        "restore_doc",
        "retire_doc",
        "revise_memory",
        "revise_transcript",
        "save_to_layer",
        "save_transcript",
        "semantic_recall",
        "validate_doc",
        "write_doc",
        "write_doc_abort",
        "write_doc_append",
        "write_doc_begin",
        "write_doc_commit"
      ]
    }
  }
}
