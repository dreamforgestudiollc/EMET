{
  "name": "@dreamforgestudiollc/emet",
  "version": "0.2.4",
  "description": "EMET — Enduring Memory & Epistemic Tiers. An MCP memory server with persistent shared memory for AI agents, bot teams and chats: layered memory, verified writes, and a verbatim transcript tier.",
  "keywords": [
    "agent-memory",
    "ai-agents",
    "ai-memory",
    "claude",
    "grok",
    "llm-memory",
    "long-term-memory",
    "mcp",
    "mcp-server",
    "memory-server",
    "model-context-protocol",
    "mongodb",
    "multi-agent",
    "neurodivergent",
    "nodejs",
    "oauth",
    "persistent-memory",
    "shared-memory"
  ],
  "license": "MIT",
  "mcpName": "io.github.dreamforgestudiollc/emet",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "emet": "src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "templates/",
    "guides/",
    "docs/*.md",
    "CHARTER.md",
    "CHANGELOG.md",
    "server.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://dreamforgestudiollc.github.io/EMET/",
  "bugs": {
    "url": "https://github.com/dreamforgestudiollc/EMET/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamforgestudiollc/EMET.git"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http-remote.js",
    "test": "node tests/run-all-tests.js",
    "coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mongodb": "^7.1.0",
    "express": "^5.2.1"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
