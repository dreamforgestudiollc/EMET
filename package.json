{
  "name": "@dreamforgestudiollc/emet",
  "version": "0.3.2",
  "description": "EMET 0.3.2 — Enduring Memory & Epistemic Tiers. An MCP memory server with persistent shared memory for AI agents, bot teams and chats: layered memory, verified writes, a verbatim transcript tier, per-client attribution and approvals, and client-side GEM execution. EMET verifies the record, not the computation. A GEM is seated only when its released flag is true. Every error carries a stable code; the owner-only emet_error_report returns a report and an email draft the user sends. npm run verify drives the registered tools from a checkout, and docs/features is the map of every feature.",
  "keywords": [
    "agent-memory",
    "ai-agents",
    "ai-memory",
    "attribution",
    "claude",
    "document-control",
    "gem",
    "grok",
    "llm-memory",
    "long-term-memory",
    "mcp",
    "mcp-server",
    "memory-server",
    "model-context-protocol",
    "mongodb",
    "multi-agent",
    "neurodivergent",
    "nodejs",
    "oauth",
    "persistent-memory",
    "shared-memory"
  ],
  "license": "MIT",
  "mcpName": "io.github.dreamforgestudiollc/emet",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "emet": "src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "verification/",
    "templates/",
    "areas/",
    "guides/",
    "gems/",
    "docs/*.md",
    "CHARTER.md",
    "CHANGELOG.md",
    "server.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://dreamforgestudiollc.github.io/EMET/",
  "bugs": {
    "url": "https://github.com/dreamforgestudiollc/EMET/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamforgestudiollc/EMET.git"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http-remote.js",
    "test": "node tests/run-all-tests.js",
    "verify": "node scripts/verify-emet.mjs",
    "coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acorn": "8.19.0",
    "express": "^5.2.1",
    "mongodb": "^7.1.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
