    "emet_invite_create",
    "emet_member_access_create",
    "emet_page",
    "emet_page_lint",
    "emet_pages",
    "emet_session_close",
    "emet_session_open",
    "emet_setup_complete",
    "emet_status",
    "emet_subkey_claim",
    "emet_subkey_end_session",
    "emet_subkey_request",
    "emet_subkey_revoke",
    "emet_transcript_append",
    "list_docs",
    "patch_doc",
    "query_layer",
    "query_transcripts",
    "read_doc",
    "read_doc_history",
    "recall",
