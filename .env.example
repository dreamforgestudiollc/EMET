# EMET configuration.
# Copy this file to .env and fill it in. .env is gitignored - never commit it.
# Real environment variables always take precedence over this file.

# ---- storage (required) ----
# Atlas: the mongodb+srv:// string from Connect -> Drivers.
# A local MongoDB (6 or later) also works: MONGODB_URI=mongodb://127.0.0.1:27017/
# Only semantic_recall needs Atlas (its vector index); everything else runs on either.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=emet

# ---- provenance ----
# Every write records the host that made it (its source tag). Register the tags
# your hosts and bots will use, so a typo is marked, not invented. List every tag
# you will give the setup interview or pass as `source` - while this is set, a
# transcript append under a tag not listed here is refused.
# Unset = any tag is accepted, and the bot guards (bots/ folders, main records)
# are OFF. See docs/BOTS.md before adding a bot's tag.
EMET_SOURCE_TAGS=laptop,phone,cli
# A remote server shared by several hosts: do not set EMET_SOURCE_TAG - a default
# makes every host look the same; each host passes its own tag on the write.
# A server used by one host only may set its default tag:
# EMET_SOURCE_TAG=laptop

# HMAC key for signed digests. Generate once, keep only here / on your host.
# Never commit a real value. Never store it in Mongo. Unset = entries are saved
# "unsigned" (everything else works). To make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EMET_SIGNING_KEY=

# Two doors for a second person into THIS store, each off unless set to 1.
# Leave both unset on a single-person assistant.
# EMET Guest Access: one-time codes for read access. Set to 1 only on a
# household or project EMET meant to be shared.
# EMET_INVITES=1
# EMET Member Access: one-time codes for a new person with read and write
# access (never the owner). Separate from guest access.
# EMET_MEMBER_ACCESS=1
# Strict login tags: a login bound to a tag may write only under that tag; a
# different declared source is refused. Off by default. Turn it on only once
# each bot has its own login (for example a Member Access code bound to its tag);
# on a shared login every other bot's writes would be refused.
# EMET_STRICT_LOGIN_TAG=1
# Delegated client sub-keys (EMET-0001). Off unless set to 1: one shared owner
# login, each bot holding its own key as a local secret. Off is no behavior
# change. First-use setup asks whether more than one bot or AI will use this
# memory. Leaving it out, or no, leaves these commented. Yes writes
# EMET_SUBKEYS=1, a generated pepper, and EMET_SUBKEY_PEPPER_VERSION=1 into
# this file only when the server reads it. A hosted deploy, where real
# environment variables are the config source, refuses that yes: set the
# three variables in the platform, then redeploy. Setup does not write a
# pepper into a container .env. Copying this example does not turn them on.
# See docs/SUBKEYS.md.
# The pepper is a server secret of at least 32 bytes, never stored in
# the database. EMET_SUBKEY_PEPPER_VERSION defaults to 1. While rotating, set
# EMET_SUBKEY_PEPPER_PREV and EMET_SUBKEY_PEPPER_PREV_VERSION so seals made
# with the previous pepper still verify. Keys last EMET_SUBKEY_TTL_DAYS
# (default 30, at most 90). A replaced key stays valid for
# EMET_SUBKEY_GRACE_MINUTES (default 10; 0 revokes it at once).
# EMET_SUBKEYS=1
# Turning EMET_SUBKEYS off ends every live sub-key session once, in the
# background at startup, when the sub-key collection already exists. The
# history event is written before the status change. Each ended session is
# kept and is not deleted. If that collection does not exist, startup does
# not create it. The sweep tries once, then a few times with backoff, and
# does not block the server accepting calls.
# With the flag off, a write that presents an emh_ handle is refused without
# opening the store. A write that names a sub-key session is refused the
# same way only when that session was live at this process's sweep. The
# refusal lasts until the next restart, by which time those sessions are
# already ended. The tool list stays the flag-off list either way.
# A store that ran the first sub-key build (rows inside emet/CLIENT_APPROVALS.md)
# still has those rows in that document's history. Production did not run it.
# EMET_SUBKEY_PEPPER=
# EMET_SUBKEY_PEPPER_VERSION=1
# EMET_SUBKEY_PEPPER_PREV=
# EMET_SUBKEY_PEPPER_PREV_VERSION=
# EMET_SUBKEY_GRACE_MINUTES=10
# EMET_SUBKEY_TTL_DAYS=30
# EMET_SUBKEY_FAIL_MAX=5
# How long a failed presentation counts, in milliseconds. Default 15 minutes.
# Values below 1000 are ignored.
# EMET_SUBKEY_FAIL_WINDOW_MS=900000

# The monorail, the server-side check on the order of a session's writes
# (docs/GUARDRAILS-AND-MONORAILS.md), runs in enforce only and has no setting:
# EMET_SESSION_GRAPH is no longer read. Every check is stored in <prefix>graph_lab;
# emet_gaps summarizes it.

# Optional. The time zone session ids are dated in (IANA name). Set it to your
# own zone, so an evening session carries your day, not UTC's. If unset, the
# default is America/New_York.
# EMET_TIMEZONE=America/New_York

# Optional. Address used by emet_error_report for the mailto draft and the
# structured email a calling assistant can pass to its own mail tool. Unset
# uses reports@example.com. That address is a placeholder, not a mailbox:
# configure this to a real address, or the report is returned and goes nowhere.
# EMET does not send mail. An empty string (a real empty environment
# variable, not a blank line in this file) returns the report and no email.
# The assistant may send the report only after showing it to you and getting
# your OK.
# EMET_REPORT_EMAIL=

# Optional. Minutes after a complete close in which the session still takes its
# ONE closing exchange (the reply sent after emet_session_close). After that one
# append, or once the window passes, the session is locked. Default 5; 0 = off;
# at most 60 (a larger value is capped at 60). A negative or non-numeric value
# is not used: the server logs a warning and uses 5. The legacy name
# CASCADE_CLOSE_GRACE_MINUTES is still read as a deprecated fallback; EMET_ wins.
# EMET_CLOSE_GRACE_MINUTES=5

# Optional. The date from which this record is held to the current rules.
# Set it and the startup line reports gaps SINCE this date beside the lifetime
# figure - the lifetime figure never falls once history is in the store; the
# since-baseline figure is the one that should trend to zero.
# EMET_GAP_BASELINE=2026-09-07

# Optional. Startup page size in bytes: emet_initialize is served in pages that
# each fit this budget (default 18000; clamped to 12000-19000). Lower it only for
# a host that cuts results shorter than the usual 20,000-byte limit.
# EMET_INIT_PAGE_BYTES=18000

# Optional. read_doc page limit in bytes as the host receives it (default 18000):
# a page ends before its JSON-escaped text plus 1,500 bytes for the rest of the
# result would pass it, on a whole character. Offsets are UTF-8 bytes.
# EMET_READ_DOC_PAGE=18000

# ---- document names (optional; defaults shown) ----
# The session handoff and the board.
# EMET_HANDOFF_DOC=HANDOFF.md
# EMET_STATE_DOC=STATE.md
# The user's host-and-machine notes.
# EMET_INSTALL_DOC=bootstrap/INSTALL.md
# The character document (character and voice). When unset, the usual
# bootstrap names are tried in order (bootstrap/CHARACTER.md first).
# EMET_CHARACTER_DOC=bootstrap/CHARACTER.md
# More record documents, beside the handoff (comma-separated ids): kept as
# superseded records, never amended. Bot handoffs are listed here, e.g.
# bots/<tag>/HANDOFF.md.
# EMET_RECORD_DOCS=
# More document-to-template mappings for validate_doc, as id=template pairs
# (comma-separated). Additive only: an entry that would change a built-in
# mapping is ignored and reported.
# EMET_TEMPLATE_MAP=

# ---- http transport only (src/http-remote.js) ----
PORT=8849
# Local use: keep the server on this machine only.
HOST=127.0.0.1
# Deploy-only (container/host behind a proxy): listen on all interfaces.
# HOST=0.0.0.0
# When deployed: must exactly match the deployed https URL - it is the OAuth issuer.
# Leave it unset to run the HTTP server on this machine; it then defaults to
# http://127.0.0.1:PORT.
# PUBLIC_URL=https://your-deployment.example.com
# Typed once per device to authorize it. This is the whole perimeter. Make it strong.
# While it is unset, the HTTP server refuses every authorization.
# EMET_OAUTH_PASSPHRASE=
# The server trusts exactly one proxy hop (Railway's edge). TRUST_PROXY is not read.
# Client ID Metadata Documents are advertised by default; 0 falls back to
# Dynamic Client Registration only (a rollback with no redeploy).
# EMET_CIMD=1
# One redacted log line per OAuth/MCP request and per error response; 0 silences it.
# EMET_REQUEST_LOG=1

# ---- optional ----
# Collection name prefix. Governs layer collections, the counters collection and the
# OAuth collections. Change only before first use - or set it to cascade_ to adopt an
# existing upstream CASCADE store in place. See docs/SETUP.md, "Migrating an existing
# CASCADE deployment".
# EMET_COLLECTION_PREFIX=emet_

# Atlas Vector Search index used by semantic_recall. Migrating installs set this to
# cascade_content_auto.
# EMET_VECTOR_INDEX=emet_content_auto

# Optional supplementary corpus searched by corpus_recall.
# EMET_CORPUS_COLLECTION=corpus_chunks
# EMET_CORPUS_INDEX=corpus_content_auto

# Comma-separated names for the optional supplementary corpus searched by
# corpus_recall. Leave unset unless you have populated a corpus yourself.
# EMET_CORPORA=

# Optional. GEM ids this install asked to turn on, comma-separated.
# Unset means a GEM activates only when its manifest says defaultOn.
# Neurendipity ships bundled and off. Set this to keep that guidance active:
# EMET_ACTIVE_GEMS=neurendipity

# Diagnostics.
LOG_LEVEL=info
LOG_FORMAT=text
# DEBUG=true
# EMET_AUDIT_LOG=
# EMET_CRASH_LOG=

# Attribution v2: the chief-of-staff bot that reviews new clients. Unset: the owner reviews them.
# EMET_COS_TAG=hub-bot
