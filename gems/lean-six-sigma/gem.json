  "knowledge": {
    "reviewBy": "2027-10-11",
    "sources": [
      {
        "title": "NIST/SEMATECH e-Handbook 6.1.6 Process capability indices",
        "date": "2026-10-11",
        "note": "Capability index algebra for Cp, Cpu, Cpl, Cpk, and the overall-sigma forms Pp and Ppk. Normal model is named when the handbook meaning is used. https://www.itl.nist.gov/div898/handbook/pmc/section1/pmc16.htm"
      },
      {
        "title": "NIST/SEMATECH e-Handbook 6.3.2.1 Shewhart X-bar and R charts",
        "date": "2026-10-11",
        "note": "Live check 2026-10-11. Control chart factors for n = 2 through 10. For n = 5 the page prints A2 = 0.577, D3 = 0, D4 = 2.115. https://www.itl.nist.gov/div898/handbook/pmc/section3/pmc321.htm"
      },
      {
        "title": "NIST/SEMATECH e-Handbook 6.3.2.2 Individuals and moving range",
        "date": "2026-10-11",
        "note": "Individuals limits use 3 * MR-bar / d2 with d2 = 1.128 for span 2. Moving-range D4 is the n = 2 factor 3.267. https://www.itl.nist.gov/div898/handbook/pmc/section3/pmc322.htm"
      },
      {
        "title": "NIST/SEMATECH e-Handbook 6.3.3.1 c and u charts",
        "date": "2026-10-11",
        "note": "Poisson count charts. The handbook c chart example is c-bar = 16, upper limit 28, lower limit 4. https://www.itl.nist.gov/div898/handbook/pmc/section3/pmc331.htm"
      },
      {
        "title": "NIST/SEMATECH e-Handbook 6.3.3.2 p and np charts",
        "date": "2026-10-11",
        "note": "Binomial charts. Variance is n * p * (1 - p) for the count and p * (1 - p) / n for the proportion. https://www.itl.nist.gov/div898/handbook/pmc/section3/pmc332.htm"
      },
      {
        "title": "ASQ Certified Six Sigma Black Belt body of knowledge",
        "date": "2026-10-11",
        "note": "DMAIC, DFSS, Lean tools, and the measurement and analysis topics this GEM coaches. Yellow and Green notes are this GEM's coaching scope and are reviewed against ASQ by 2027-10-11. This package does not certify. https://www.asq.org/cert/six-sigma-black-belt"
      }
    ]
  },
